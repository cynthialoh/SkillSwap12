# Local development example only. Replace with a private, managed PostgreSQL URL.
DATABASE_URL="postgresql://skillswap:skillswap@localhost:5432/skillswap?schema=public"
APP_ENV="development"
LOG_LEVEL="info"

# Authentication and transactional email (Better Auth + ZeptoMail).
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
BETTER_AUTH_URL="http://127.0.0.1:3000"
APP_BASE_URL="http://127.0.0.1:3000"
# Generate a private 32+ character key, for example with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_LINK_ENCRYPTION_KEY=""
ZEPTOMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="SkillSwap"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_RECOVERY="false"
# Keep disabled by default; enable only against an isolated verification database or controlled beta.
CREDIT_SETTLEMENT_ENABLED="false"
SKILLSWAP_CREDIT_POLICY_APPROVED_VERSION="phase1-approved-v1"
