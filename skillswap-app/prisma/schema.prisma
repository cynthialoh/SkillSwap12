  @@index([ownerId, status, updatedAt])
}

model LearningPlanStep {
  id          String       @id @default(cuid())
  planId      String
  title       String       @db.VarChar(120)
  details     String?      @db.VarChar(500)
  reflection  String?      @db.VarChar(500)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  plan        LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

model CommunityPostReaction {
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model CommunityPostComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  body      String        @db.VarChar(1000)
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model CommunityPostSave {
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model CommunityContentReport {
  id           String                @id @default(cuid())
  postId       String
  reporterId   String
  category     String                @db.VarChar(40)
  details      String                @db.VarChar(1000)
  status       CommunityReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  post         CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter     User                  @relation("CommunityReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?                 @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

model MutedMember {
  userId      String
  mutedUserId String
  createdAt   DateTime @default(now())
  user        User     @relation("MutedMemberOwner", fields: [userId], references: [id], onDelete: Cascade)
  mutedUser   User     @relation("MutedMemberTarget", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@id([userId, mutedUserId])
  @@index([mutedUserId])
}

model ProfileAccessRequest {
  id          String              @id @default(cuid())
  requesterId String
  ownerId     String
  status      ProfileAccessStatus @default(PENDING)
  reason      String?             @db.VarChar(500)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  decidedAt   DateTime?
  requester   User                @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner       User                @relation("AccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId])
  @@index([ownerId, status, createdAt])
  @@index([requesterId, status])
}

model ProfileBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  reason        String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  blocker       User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model AdminGrant {
  userId      String   @id
  grantedById String?
  reason      String   @db.VarChar(500)
  grantedAt   DateTime @default(now())
  user        User     @relation("AdminGrantee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?    @relation("AdminGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([grantedById])
}

model AdminQueueAssignment {
  id          String             @id @default(cuid())
  itemType    String             @db.VarChar(30)
  itemId      String             @db.VarChar(100)
  priority    AdminQueuePriority @default(NORMAL)
  assigneeId  String?
  updatedById String
  reason      String             @db.VarChar(500)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignee    User?              @relation("QueueAssignedAdmin", fields: [assigneeId], references: [id], onDelete: SetNull)
  updatedBy   User               @relation("QueueAssignmentEditor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([itemType, itemId])
  @@index([assigneeId, priority, updatedAt])
  @@index([itemType, priority, updatedAt])
}

model SecurityAuditEvent {
  id           String   @id @default(cuid())
  eventKey     String   @db.VarChar(80)
  actorId      String?
  targetUserId String?
  reason       String?  @db.VarChar(500)
  details      Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([eventKey, createdAt])
  @@index([targetUserId, createdAt])
}
