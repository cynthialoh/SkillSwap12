{
  "name": "skillswap-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack --hostname 127.0.0.1",
    "prebuild": "prisma generate",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "verification:credits": "tsx scripts/seed-credit-verification.ts",
    "sessions:reminders": "tsx scripts/send-session-reminders.ts",
    "notifications:send": "tsx scripts/send-notification-emails.ts",
    "verification:retention": "tsx scripts/verification-retention.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "17.2.2",
    "next": "16.4.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.25.12": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
